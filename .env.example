# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Porta onde o servidor Express escuta (padrão: 3000)
PORT=3000

# ALLOWED_ORIGIN: Origem do frontend autorizada para requisições CORS com credenciais
ALLOWED_ORIGIN="https://eletro-zeta.vercel.app"

# VITE_API_URL: URL base pública do backend Node/Express persistente em produção.
# Configure nas Environment Variables da Vercel (ex: https://api.seudominio.com).
# IMPORTANTE: NÃO deve terminar com barra e NÃO deve conter /api no final.
# Em desenvolvimento local deixe em branco.
VITE_API_URL=""

# TEACHER_PASSCODE: Senha mestra do painel pedagógico (opcional)
TEACHER_PASSCODE="prof-ares-2026"
